{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated GROW UP user",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "photoURL": {
          "type": "string"
        },
        "role": {
          "type": "string",
          "enum": [
            "athlete",
            "coach",
            "admin"
          ]
        },
        "createdAt": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        }
      },
      "required": [
        "userId",
        "email",
        "role"
      ]
    },
    "CoachApplication": {
      "title": "CoachApplication",
      "description": "Coach verification application linked to Firebase Auth",
      "type": "object",
      "properties": {
        "applicantId": {
          "type": "string"
        },
        "fullName": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "discipline": {
          "type": "string"
        },
        "profileLink": {
          "type": "string"
        },
        "documentPaths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "submitted",
            "reviewed",
            "approved",
            "rejected"
          ]
        },
        "reviewNote": {
          "type": "string"
        },
        "reviewedBy": {
          "type": "string"
        },
        "createdAt": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        }
      },
      "required": [
        "applicantId",
        "fullName",
        "email",
        "discipline",
        "status"
      ]
    },
    "CoachProfile": {
      "title": "CoachProfile",
      "description": "Public profile created for an approved coach",
      "type": "object",
      "properties": {
        "coachId": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "headline": {
          "type": "string"
        },
        "discipline": {
          "type": "string"
        },
        "bio": {
          "type": "string"
        },
        "photoURL": {
          "type": "string"
        },
        "experienceYears": {
          "type": "number"
        },
        "specialties": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "modalities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rating": {
          "type": "number"
        },
        "reviewCount": {
          "type": "number"
        },
        "verificationStatus": {
          "type": "string",
          "enum": [
            "approved"
          ]
        },
        "active": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        }
      },
      "required": [
        "coachId",
        "displayName",
        "verificationStatus",
        "active"
      ]
    },
    "CoachService": {
      "title": "CoachService",
      "description": "Bookable service published by an approved coach",
      "type": "object",
      "properties": {
        "coachId": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "single_session",
            "package",
            "subscription"
          ]
        },
        "durationMinutes": {
          "type": "number"
        },
        "priceCents": {
          "type": "number"
        },
        "currency": {
          "type": "string"
        },
        "active": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        }
      },
      "required": [
        "coachId",
        "title",
        "type",
        "durationMinutes",
        "priceCents",
        "currency",
        "active"
      ]
    },
    "CoachAvailability": {
      "title": "CoachAvailability",
      "description": "Explicit coach availability slot",
      "type": "object",
      "properties": {
        "coachId": {
          "type": "string"
        },
        "startAt": {
          "type": "string"
        },
        "endAt": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "available",
            "reserved",
            "booked",
            "cancelled"
          ]
        },
        "bookingId": {
          "type": "string"
        },
        "createdAt": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        }
      },
      "required": [
        "coachId",
        "startAt",
        "endAt",
        "status"
      ]
    },
    "Booking": {
      "title": "Booking",
      "description": "Atomic athlete booking of a coach service and availability slot",
      "type": "object",
      "properties": {
        "athleteId": {
          "type": "string"
        },
        "coachId": {
          "type": "string"
        },
        "serviceId": {
          "type": "string"
        },
        "slotId": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "confirmed",
            "completed",
            "cancelled"
          ]
        },
        "paymentStatus": {
          "type": "string",
          "enum": [
            "unpaid",
            "pending",
            "paid",
            "refunded"
          ]
        },
        "createdAt": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        }
      },
      "required": [
        "athleteId",
        "coachId",
        "serviceId",
        "slotId",
        "status",
        "paymentStatus"
      ]
    },
    "ConsultationRequest": {
      "title": "ConsultationRequest",
      "description": "Legacy/free consultation request",
      "type": "object",
      "properties": {
        "athleteId": {
          "type": "string"
        },
        "athleteName": {
          "type": "string"
        },
        "athleteEmail": {
          "type": "string"
        },
        "coachId": {
          "type": "string"
        },
        "coachName": {
          "type": "string"
        },
        "sport": {
          "type": "string"
        },
        "goal": {
          "type": "string"
        },
        "level": {
          "type": "string"
        },
        "modality": {
          "type": "string"
        },
        "preferredSlot": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "confirmed",
            "completed",
            "cancelled"
          ]
        },
        "createdAt": {
          "type": "string"
        }
      },
      "required": [
        "athleteName",
        "athleteEmail",
        "coachId",
        "coachName",
        "preferredSlot",
        "status"
      ]
    },
    "ContactMessage": {
      "title": "ContactMessage",
      "description": "Website contact/support message",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "createdAt": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "email",
        "message"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Authenticated users and roles"
    },
    "/coachApplications/{applicationId}": {
      "schema": "CoachApplication",
      "description": "Coach verification workflow"
    },
    "/coachProfiles/{coachId}": {
      "schema": "CoachProfile",
      "description": "Approved public coach profiles"
    },
    "/coachServices/{serviceId}": {
      "schema": "CoachService",
      "description": "Coach tariffs and services"
    },
    "/coachAvailability/{slotId}": {
      "schema": "CoachAvailability",
      "description": "Bookable coach time slots"
    },
    "/bookings/{bookingId}": {
      "schema": "Booking",
      "description": "Athlete bookings"
    },
    "/consultationRequests/{requestId}": {
      "schema": "ConsultationRequest",
      "description": "Free consultation requests"
    },
    "/contactMessages/{messageId}": {
      "schema": "ContactMessage",
      "description": "Contact messages"
    }
  },
  "storage": {
    "/coach-documents/{uid}/{applicationId}/{fileName}": {
      "description": "Private coach verification documents; applicant and admin access only"
    }
  }
}
