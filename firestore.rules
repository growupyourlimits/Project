rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn(){ return request.auth != null; }
    function owner(uid){ return signedIn() && request.auth.uid == uid; }
    function admin(){ return signedIn() && request.auth.token.email == 'growupyourlimits@gmail.com' && request.auth.token.email_verified == true; }
    function coach(){ return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'coach'; }

    match /users/{uid} {
      allow read: if owner(uid) || admin();
      allow create: if owner(uid) && request.resource.data.userId == uid && request.resource.data.role == 'athlete';
      allow update: if admin() || (owner(uid) && request.resource.data.userId == resource.data.userId &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','photoURL','updatedAt']));
      allow delete: if admin();
    }

    match /coachApplications/{id} {
      allow create: if signedIn() && request.resource.data.applicantId == request.auth.uid && request.resource.data.status == 'submitted';
      allow read: if admin() || (signedIn() && resource.data.applicantId == request.auth.uid);
      allow update, delete: if admin();
    }

    match /coachProfiles/{uid} {
      allow read: if resource.data.active == true && resource.data.verificationStatus == 'approved' || owner(uid) || admin();
      allow create: if admin();
      allow update: if admin() || (owner(uid) && coach() &&
        request.resource.data.coachId == uid &&
        request.resource.data.verificationStatus == resource.data.verificationStatus &&
        request.resource.data.active == resource.data.active &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','headline','bio','discipline','tags','modalities','experienceYears','specialties','photoURL','updatedAt']));
      allow delete: if admin();
    }

    match /coachServices/{id} {
      allow read: if resource.data.active == true || admin() || (signedIn() && resource.data.coachId == request.auth.uid);
      allow create: if coach() && request.resource.data.coachId == request.auth.uid;
      allow update, delete: if admin() || (coach() && resource.data.coachId == request.auth.uid &&
        request.resource.data.coachId == resource.data.coachId);
    }

    match /coachAvailability/{id} {
      allow read: if resource.data.status == 'available' || admin() || (signedIn() && resource.data.coachId == request.auth.uid);
      allow create: if coach() && request.resource.data.coachId == request.auth.uid && request.resource.data.status == 'available';
      allow update: if admin() ||
        (coach() && resource.data.coachId == request.auth.uid && request.resource.data.coachId == resource.data.coachId) ||
        (signedIn() &&
          resource.data.status == 'available' &&
          request.resource.data.coachId == resource.data.coachId &&
          request.resource.data.status == 'reserved' &&
          request.resource.data.bookingId is string &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','bookingId','updatedAt']) &&
          getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.athleteId == request.auth.uid &&
          getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.coachId == resource.data.coachId &&
          getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.slotId == id);
      allow delete: if admin() || (coach() && resource.data.coachId == request.auth.uid);
    }

    match /bookings/{id} {
      allow create: if signedIn() && request.resource.data.athleteId == request.auth.uid &&
        request.resource.data.status == 'pending' && request.resource.data.paymentStatus == 'unpaid' &&
        request.resource.data.coachId is string && request.resource.data.serviceId is string && request.resource.data.slotId is string;
      allow read: if admin() || (signedIn() && (resource.data.athleteId == request.auth.uid || resource.data.coachId == request.auth.uid));
      allow update: if admin() || (coach() && resource.data.coachId == request.auth.uid &&
        request.resource.data.athleteId == resource.data.athleteId && request.resource.data.coachId == resource.data.coachId);
      allow delete: if admin();
    }

    match /consultationRequests/{id} {
      allow create: if request.resource.data.status == 'pending' &&
        request.resource.data.athleteName is string && request.resource.data.athleteName.size() > 0 && request.resource.data.athleteName.size() <= 100 &&
        request.resource.data.athleteEmail is string && request.resource.data.athleteEmail.size() > 3 && request.resource.data.athleteEmail.size() <= 128 &&
        request.resource.data.coachId is string && request.resource.data.coachName is string &&
        request.resource.data.preferredSlot is string && request.resource.data.preferredSlot.size() <= 100;
      allow read: if admin() || (signedIn() && (resource.data.athleteId == request.auth.uid || resource.data.coachId == request.auth.uid));
      allow update: if admin() || (coach() && resource.data.coachId == request.auth.uid);
      allow delete: if admin();
    }

    match /contactMessages/{id} {
      allow create: if request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100 &&
        request.resource.data.email is string && request.resource.data.email.size() > 3 && request.resource.data.email.size() <= 128 &&
        request.resource.data.message is string && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 2000;
      allow read, update, delete: if admin();
    }

    match /{document=**} { allow read, write: if false; }
  }
}