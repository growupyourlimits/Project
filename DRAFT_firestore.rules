rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all unknown collections
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() &&
        request.auth.token.email == 'growupyourlimits@gmail.com' &&
        request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validation Helper: UserProfile ---
    function isValidUser(data) {
      return data.keys().hasAll(['userId', 'email', 'displayName', 'role']) &&
        data.keys().hasOnly(['userId', 'email', 'displayName', 'role', 'photoURL', 'createdAt', 'updatedAt']) &&
        data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
        data.email is string && data.email.size() > 3 && data.email.size() <= 128 &&
        data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100 &&
        data.role in ['athlete', 'coach', 'admin'] &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    // --- Validation Helper: ConsultationRequest ---
    function isValidConsultationRequest(data) {
      return data.keys().hasAll(['athleteName', 'athleteEmail', 'coachName', 'preferredSlot', 'status']) &&
        data.keys().hasOnly(['id', 'athleteId', 'athleteName', 'athleteEmail', 'coachId', 'coachName', 'sport', 'goal', 'level', 'modality', 'preferredSlot', 'status', 'createdAt']) &&
        data.athleteName is string && data.athleteName.size() > 0 && data.athleteName.size() <= 100 &&
        data.athleteEmail is string && data.athleteEmail.size() > 3 && data.athleteEmail.size() <= 128 &&
        data.coachName is string && data.coachName.size() > 0 && data.coachName.size() <= 100 &&
        data.preferredSlot is string && data.preferredSlot.size() > 0 && data.preferredSlot.size() <= 100 &&
        data.status in ['pending', 'confirmed', 'completed', 'cancelled'] &&
        (!('id' in data) || (data.id is string && data.id.size() <= 128)) &&
        (!('athleteId' in data) || (data.athleteId is string && data.athleteId.size() <= 128)) &&
        (!('coachId' in data) || (data.coachId is string && data.coachId.size() <= 64)) &&
        (!('sport' in data) || (data.sport is string && data.sport.size() <= 64)) &&
        (!('goal' in data) || (data.goal is string && data.goal.size() <= 100)) &&
        (!('level' in data) || (data.level is string && data.level.size() <= 100)) &&
        (!('modality' in data) || (data.modality is string && data.modality.size() <= 100)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64));
    }

    // --- Validation Helper: CoachApplication ---
    function isValidCoachApplication(data) {
      return data.keys().hasAll(['fullName', 'email', 'discipline', 'status']) &&
        data.keys().hasOnly(['id', 'fullName', 'email', 'discipline', 'profileLink', 'status', 'createdAt']) &&
        data.fullName is string && data.fullName.size() > 0 && data.fullName.size() <= 100 &&
        data.email is string && data.email.size() > 3 && data.email.size() <= 128 &&
        data.discipline is string && data.discipline.size() > 0 && data.discipline.size() <= 100 &&
        data.status in ['submitted', 'reviewed', 'approved', 'rejected'] &&
        (!('id' in data) || (data.id is string && data.id.size() <= 128)) &&
        (!('profileLink' in data) || (data.profileLink is string && data.profileLink.size() <= 300)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64));
    }

    // --- Validation Helper: ContactMessage ---
    function isValidContactMessage(data) {
      return data.keys().hasAll(['name', 'email', 'message']) &&
        data.keys().hasOnly(['id', 'name', 'email', 'message', 'createdAt']) &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
        data.email is string && data.email.size() > 3 && data.email.size() <= 128 &&
        data.message is string && data.message.size() > 0 && data.message.size() <= 2000 &&
        (!('id' in data) || (data.id is string && data.id.size() <= 128)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64));
    }

    // 1. Users collection
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) && isOwner(userId) && isValidUser(incoming()) && incoming().userId == userId;
      allow update: if isValidId(userId) && isValidUser(incoming()) && (
        (isOwner(userId) && incoming().userId == existing().userId && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt'])) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // 2. Consultation Requests collection
    match /consultationRequests/{requestId} {
      allow get: if isValidId(requestId) && (
        isAdmin() ||
        (isSignedIn() && resource.data.athleteId == request.auth.uid)
      );
      allow list: if isAdmin() || (isSignedIn() && resource.data.athleteId == request.auth.uid);
      allow create: if isValidId(requestId) && isValidConsultationRequest(incoming());
      allow update: if isValidId(requestId) && isAdmin();
      allow delete: if isValidId(requestId) && isAdmin();
    }

    // 3. Coach Applications collection
    match /coachApplications/{applicationId} {
      allow get: if isValidId(applicationId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(applicationId) && isValidCoachApplication(incoming());
      allow update: if isValidId(applicationId) && isAdmin();
      allow delete: if isValidId(applicationId) && isAdmin();
    }

    // 4. Contact Messages collection
    match /contactMessages/{messageId} {
      allow get: if isValidId(messageId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(messageId) && isValidContactMessage(incoming());
      allow update: if isValidId(messageId) && isAdmin();
      allow delete: if isValidId(messageId) && isAdmin();
    }

    // 5. Test connection collection
    match /test/{docId} {
      allow read: if true;
    }
  }
}
